# =============================================================================
# ClassTrace Backend Production Environment Configuration (.env)
# =============================================================================

# Gnani AI Trio Model Suite Credentials
# Register & obtain your official API Key at https://dashboard.gnani.ai
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# 1. Prisma v2.5: High-Speed Streaming Speech-to-Text (<200ms latency, 14M+ hrs)
GNANI_STT_MODEL=prisma-v2.5
GNANI_LANGUAGE_CODE=indic-auto

# 2. Timbre v2.5: Context-Aware Text-to-Speech (10+ Indic languages, lakh/crore cadence)
GNANI_TTS_MODEL=timbre-v2.5

# 3. Evon v3.3: 30B Mixture-of-Experts Multilingual Indic Reasoning (128K context)
GNANI_REASONING_MODEL=evon-v3.3
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
EVON_HUGGINGFACE_REPO=gnani-ai/evon-v3.3

# Supabase PostgreSQL & Storage Configuration
# If left empty, ClassTrace runs seamlessly on the local SQLite 17-Q engine
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
APP_ENV=production
MAX_UPLOAD_SIZE_MB=150
