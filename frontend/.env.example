# =============================================================================
# ClassTrace Frontend Production Environment Configuration (.env)
# =============================================================================

# FastAPI Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Feature Flags (Scope Freeze: Prisma STT is primary; Timbre & Evon isolated to experimental)
NEXT_PUBLIC_ENABLE_PRISMA_STT=true
NEXT_PUBLIC_ENABLE_TIMBRE_TTS=false
NEXT_PUBLIC_ENABLE_EVON_REASONING=false
